{
  "schema_version": 1,

  "aws": {
    "region": "ap-south-1"
  },

  "project": {
    "name": "CloudVPN-IaC",
    "deployment_id": "cloudvpn-personal",
    "environment": "Production",
    "owner": "VPN Owner"
  },

  "network": {
    "vpc_cidr": "10.0.0.0/16",
    "public_subnet_cidr": "10.0.1.0/24",
    "availability_zone": null
  },

  "ec2": {
    "instance_type": "t3.micro",
    "root_volume_size": 20
  },

  "wireguard": {
    "port": 51820,
    "interface": "wg0",
    "network": "10.8.0.0/24",
    "server_address": "10.8.0.1/24",
    "dns": "1.1.1.1",
    "firewall_enabled": true
  },

  "client": {
    "name": "client1",
    "address": "10.8.0.2/32",
    "dns": "1.1.1.1",
    "allowed_ips": "0.0.0.0/0, ::/0",
    "persistent_keepalive": 25
  },

  "ssm": {
    "bucket_name": "REPLACE_WITH_YOUR_SSM_BUCKET"
  }
}
