[Interface]
Address = {{ wireguard_server_address }}
ListenPort = {{ wireguard_port }}
PrivateKey = {{ wireguard_server_private_key_content.content | b64decode | trim }}

# NAT VPN traffic through the EC2 external interface.
# Forwarding and peer isolation are managed by CloudVPN firewall chains.
PostUp = iptables -t nat -A POSTROUTING -s {{ wireguard_network }} -o {{ wireguard_external_interface }} -j MASQUERADE
PostDown = iptables -t nat -D POSTROUTING -s {{ wireguard_network }} -o {{ wireguard_external_interface }} -j MASQUERADE

[Peer]
# Windows client
PublicKey = {{ wireguard_client_public_key }}
AllowedIPs = {{ wireguard_client_address }}
