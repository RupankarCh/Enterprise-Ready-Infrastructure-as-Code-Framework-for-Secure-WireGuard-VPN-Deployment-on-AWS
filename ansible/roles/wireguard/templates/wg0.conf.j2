[Interface]
Address = {{ wireguard_server_address }}
ListenPort = {{ wireguard_port }}
PrivateKey = {{ wireguard_server_private_key_content.content | b64decode | trim }}

# Forward VPN traffic to the internet through EC2
PostUp = iptables -A FORWARD -i %i -o {{ wireguard_external_interface }} -j ACCEPT; iptables -A FORWARD -i {{ wireguard_external_interface }} -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -A POSTROUTING -s {{ wireguard_network }} -o {{ wireguard_external_interface }} -j MASQUERADE

# Remove forwarding and NAT rules when WireGuard stops
PostDown = iptables -D FORWARD -i %i -o {{ wireguard_external_interface }} -j ACCEPT; iptables -D FORWARD -i {{ wireguard_external_interface }} -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -D POSTROUTING -s {{ wireguard_network }} -o {{ wireguard_external_interface }} -j MASQUERADE

[Peer]
# Windows client
PublicKey = {{ wireguard_client_public_key }}
AllowedIPs = {{ wireguard_client_address }}
