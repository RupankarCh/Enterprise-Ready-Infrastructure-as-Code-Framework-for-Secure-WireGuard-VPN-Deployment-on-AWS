#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TERRAFORM_DIR="$PROJECT_ROOT/terraform"
CONFIG_FILE="$PROJECT_ROOT/config/deployment.json"
CONFIGURE_SCRIPT="$PROJECT_ROOT/scripts/configure.sh"
AUTHORIZATION_SCRIPT="$PROJECT_ROOT/scripts/server-key-authorization.py"
CONTROLLER_LOCK_FILE="$TERRAFORM_DIR/.cloudvpn-controller.lock"

# Track only temporary plan directories created by this controller.
CLOUDVPN_TEMP_DIRS=()

cleanup_temp_dirs() {
    local directory

    for directory in "${CLOUDVPN_TEMP_DIRS[@]}"; do
        if [[ -n "$directory" && -d "$directory" ]]; then
            rm -rf -- "$directory"
        fi
    done
}

register_temp_dir() {
    CLOUDVPN_TEMP_DIRS+=("$1")
}

trap cleanup_temp_dirs EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

success() {
    echo -e "${GREEN}[PASS]${NC} $1"
}

warning() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

error() {
    echo -e "${RED}[FAIL]${NC} $1" >&2
}

usage() {
    cat <<EOF
CloudVPN Infrastructure Controller

Usage:
  ./cloudvpn check
  ./cloudvpn configure
  ./cloudvpn status
  ./cloudvpn deploy
  ./cloudvpn destroy

Commands:
  check       Check local deployment prerequisites
  configure   Validate configuration and generate local variables
  status      Inspect local Terraform deployment state
  deploy      Provision AWS infrastructure and configure WireGuard
  destroy     Destroy Terraform-managed infrastructure after confirmation
EOF
}

check_command() {
    local missing=0

    echo
    echo "======================================"
    echo " CloudVPN Prerequisite Check"
    echo "======================================"

    for command in bash python3 terraform aws ansible-playbook wg flock; do
        if command -v "$command" >/dev/null 2>&1; then
            success "$command is installed"
        else
            error "$command is not installed"
            missing=1
        fi
    done

    if [[ -f "$CONFIG_FILE" ]]; then
        success "Deployment configuration exists"
    else
        warning "config/deployment.json is missing"
        echo "Create it from config/deployment.example.json."
        missing=1
    fi

    if [[ -f "$PROJECT_ROOT/ansible/requirements.lock.txt" ]]; then
        success "Ansible dependency lock file exists"
    else
        error "Ansible dependency lock file is missing"
        missing=1
    fi

    if [[ -f "$PROJECT_ROOT/ansible/requirements.yml" ]]; then
        success "Ansible collection requirements exist"
    else
        error "Ansible collection requirements are missing"
        missing=1
    fi

    if [[ -d "$TERRAFORM_DIR" ]]; then
        success "Terraform configuration directory exists"
    else
        error "Terraform directory is missing"
        missing=1
    fi

    echo
    if (( missing == 0 )); then
        success "Local prerequisite checks completed"
        return 0
    else
        error "One or more prerequisite checks failed"
        return 1
    fi
}

configure_command() {
    echo
    echo "======================================"
    echo " CloudVPN Configuration"
    echo "======================================"

    if [[ ! -f "$CONFIG_FILE" ]]; then
        error "Configuration file not found."
        echo "Copy config/deployment.example.json to config/deployment.json."
        return 1
    fi

    bash "$CONFIGURE_SCRIPT"

    success "Configuration completed"
}

status_command() {
    echo
    echo "======================================"
    echo " CloudVPN Deployment Status"
    echo "======================================"

    if ! command -v terraform >/dev/null 2>&1; then
        error "Terraform is not installed"
        return 1
    fi

    if [[ ! -d "$TERRAFORM_DIR/.terraform" ]]; then
        warning "Terraform has not been initialized"
        return 0
    fi

    local workspace
    workspace="$(terraform -chdir="$TERRAFORM_DIR" workspace show)"
    echo "Workspace: $workspace"

    local state_count
    state_count="$(
        terraform -chdir="$TERRAFORM_DIR" state list 2>/dev/null |
        wc -l
    )"

    echo "Managed Terraform resources: $state_count"

    if (( state_count == 0 )); then
        warning "No managed resources found in the current Terraform state"
        return 0
    fi

    echo
    echo "Deployment outputs:"

    for output in aws_region ec2_instance_id vpn_public_ip; do
        local value

        if value="$(
            terraform -chdir="$TERRAFORM_DIR" output -raw "$output" 2>/dev/null
        )"; then
            printf '  %-20s %s\n' "$output:" "$value"
        else
            printf '  %-20s %s\n' "$output:" "Unavailable"
        fi
    done

    echo
    warning "This command reads local Terraform state."
    warning "It does not independently verify live AWS resource health."
}


get_config_value() {
    python3 - "$CONFIG_FILE" "$1" <<'PYCONFIG'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as f:
    config = json.load(f)

value = config
for key in sys.argv[2].split("."):
    value = value[key]

if value is None:
    print("")
else:
    print(value)
PYCONFIG
}

verify_aws_identity() {
    local region="$1"

    if ! command -v aws >/dev/null 2>&1; then
        error "AWS CLI is not installed."
        return 1
    fi

    local account_id
    account_id="$(aws sts get-caller-identity \
        --query Account --output text --region "$region")"

    if [[ ! "$account_id" =~ ^[0-9]{12}$ ]]; then
        error "Could not verify the AWS account identity."
        return 1
    fi

    echo "AWS account: $account_id" >&2
    echo "AWS region:  $region" >&2

    printf '%s' "$account_id"
}

confirm_operation() {
    local operation="$1"
    local account_id="$2"

    echo
    warning "You are about to perform: $operation"
    echo "AWS account: $account_id"

    read -r -p "Type the AWS account ID to continue: " confirmation

    if [[ "$confirmation" != "$account_id" ]]; then
        error "Account confirmation did not match."
        return 1
    fi

    read -r -p "Type '$operation' to authorize: " operation_confirmation

    if [[ "$operation_confirmation" != "$operation" ]]; then
        error "Operation confirmation did not match."
        return 1
    fi

    return 0
}

acquire_controller_lock() {
    if ! command -v flock >/dev/null 2>&1; then
        error "flock is required for safe controller operation."
        return 1
    fi

    if [[ -L "$CONTROLLER_LOCK_FILE" ]]; then
        error "Controller lock file must not be a symlink."
        return 1
    fi

    if [[ -e "$CONTROLLER_LOCK_FILE" && ! -f "$CONTROLLER_LOCK_FILE" ]]; then
        error "Controller lock path is not a regular file."
        return 1
    fi

    if ! exec 9>>"$CONTROLLER_LOCK_FILE"; then
        error "Could not open the controller lock file."
        return 1
    fi

    chmod 600 "$CONTROLLER_LOCK_FILE" || return 1

    if ! flock -x 9; then
        error "Could not acquire the controller lock."
        return 1
    fi
}

check_workspace() {
    local workspace

    workspace="$(terraform -chdir="$TERRAFORM_DIR" workspace show)"

    if [[ "$workspace" != "default" ]]; then
        error "Unexpected Terraform workspace: $workspace"
        error "This controller currently supports only the default workspace."
        return 1
    fi
}


deploy_command() {
    acquire_controller_lock || return 1
    echo
    echo "======================================"
    echo " CloudVPN Deployment"
    echo "======================================"

    check_command || return 1
    configure_command || return 1

    local region bucket account_id instance_id
    region="$(get_config_value aws.region)"
    bucket="$(get_config_value ssm.bucket_name)"

    if [[ -z "$region" || -z "$bucket" ]]; then
        error "AWS region or SSM bucket configuration is missing."
        return 1
    fi

    terraform -chdir="$TERRAFORM_DIR" init
    terraform -chdir="$TERRAFORM_DIR" validate
    check_workspace || return 1

    account_id="$(verify_aws_identity "$region")" || return 1

    echo
    echo "Checking S3 transfer bucket access..."

    aws s3api head-bucket \
        --bucket "$bucket" \
        --region "$region" || {
            error "S3 bucket access verification failed."
            return 1
        }

    success "S3 bucket is accessible"

    local plan_dir plan_file
    plan_dir="$(mktemp -d "${TMPDIR:-/tmp}/cloudvpn-deploy.XXXXXX")"
    register_temp_dir "$plan_dir"
    chmod 700 "$plan_dir"
    plan_file="$plan_dir/deployment.tfplan"

    if ! terraform -chdir="$TERRAFORM_DIR" plan \
        -out="$plan_file"; then
        rm -rf -- "$plan_dir"
        return 1
    fi

    # Inspect the plan without printing its JSON representation.
    # Enable key generation only for a new/replaced EC2 instance.
    local planned_new_instance=false
    local generate_server_key=false

    local plan_key_decision

    if ! plan_key_decision="$(
        terraform -chdir="$TERRAFORM_DIR" show -json "$plan_file" |
        python3 "$PROJECT_ROOT/scripts/terraform-plan-needs-server-key.py"
    )"; then
        error "Could not safely analyse the Terraform plan."
        rm -rf -- "$plan_dir"
        return 1
    fi

    if [[ "$plan_key_decision" == "true" ]]; then
        planned_new_instance=true
    fi

    echo
    if [[ "$planned_new_instance" == true ]]; then
        warning "A new EC2 instance will be created."
        warning "Instance-specific key-generation authorization will be prepared."
    else
        success "No new EC2 instance is planned."
    fi

    if ! confirm_operation "DEPLOY" "$account_id"; then
        rm -rf -- "$plan_dir"
        return 1
    fi

    if ! terraform -chdir="$TERRAFORM_DIR" apply "$plan_file"; then
        rm -rf -- "$plan_dir"
        error "Terraform apply failed. Review the infrastructure state."
        return 1
    fi

    rm -rf -- "$plan_dir"
    success "Terraform infrastructure deployment completed"

    echo
    echo "Waiting for EC2 and Systems Manager readiness..."

    instance_id="$(
        terraform -chdir="$TERRAFORM_DIR" output -raw ec2_instance_id
    )" || return 1

    # Authorize initial key generation only for the instance created by
    # this deployment, or a retry of that exact instance.
    local key_authorization_file="$TERRAFORM_DIR/.cloudvpn-server-key-generation-authorized"

    if [[ "$planned_new_instance" == true ]]; then
        if ! python3 "$AUTHORIZATION_SCRIPT" prepare \
            --marker "$key_authorization_file"; then
            error "Could not prepare server-key generation authorization."
            return 1
        fi

        if ! python3 "$AUTHORIZATION_SCRIPT" bind \
            --marker "$key_authorization_file" \
            --instance-id "$instance_id"; then
            error "Could not bind server-key authorization to the new EC2 instance."
            return 1
        fi
    fi

    local authorization_status

    if ! authorization_status="$(
        python3 "$AUTHORIZATION_SCRIPT" check \
            --marker "$key_authorization_file" \
            --instance-id "$instance_id"
    )"; then
        error "Could not safely check server-key generation authorization."
        return 1
    fi

    if [[ "$authorization_status" == "true" ]]; then
        generate_server_key=true
        success "Server-key generation is authorized for this EC2 instance."
    else
        warning "Server-key generation is not authorized for this EC2 instance."
    fi

    local ready=false

    for attempt in $(seq 1 36); do
        local ping_status

        ping_status="$(
            aws ssm describe-instance-information \
                --region "$region" \
                --filters "Key=InstanceIds,Values=$instance_id" \
                --query 'InstanceInformationList[0].PingStatus' \
                --output text 2>/dev/null || true
        )"

        if [[ "$ping_status" == "Online" ]]; then
            ready=true
            break
        fi

        echo "SSM is not ready yet ($attempt/36)."
        sleep 10
    done

    if [[ "$ready" != true ]]; then
        error "SSM agent did not become ready within six minutes."
        error "Infrastructure has been preserved for diagnosis."
        return 1
    fi

    success "EC2 instance is online in Systems Manager"

    if ! bash "$PROJECT_ROOT/scripts/generate-inventory.sh" "$bucket"; then
        error "Ansible inventory generation failed."
        return 1
    fi

    local ansible_config="$PROJECT_ROOT/ansible/ansible.cfg"

    local -a ansible_args=()

    if [[ "$generate_server_key" == true ]]; then
        ansible_args+=(
            -e wireguard_server_key_generation_enabled=true
        )
    fi

    if ! ANSIBLE_CONFIG="$ansible_config" \
        ansible-playbook \
        -i "$PROJECT_ROOT/ansible/inventory/hosts.yml" \
        "$PROJECT_ROOT/ansible/playbooks/wireguard.yml" \
        "${ansible_args[@]}"; then
        error "Ansible configuration failed."
        error "AWS infrastructure has been preserved for diagnosis."
        return 1
    fi

    success "WireGuard Ansible configuration completed"

    if [[ "$generate_server_key" == true ]]; then
        if ! python3 "$AUTHORIZATION_SCRIPT" consume \
            --marker "$key_authorization_file" \
            --instance-id "$instance_id"; then
            error "WireGuard was configured, but server-key authorization could not be consumed."
            error "Review the authorization marker before another deployment."
            return 1
        fi

        success "One-time server-key authorization consumed."
    fi

    echo
    echo "======================================"
    echo " CloudVPN Deployment Completed"
    echo "======================================"

    status_command
}

destroy_command() {
    acquire_controller_lock || return 1
    echo
    echo "======================================"
    echo " CloudVPN Infrastructure Destruction"
    echo "======================================"

    local generated_config="$TERRAFORM_DIR/terraform.auto.tfvars.json"

    if [[ ! -f "$generated_config" || -L "$generated_config" ]]; then
        error "Generated Terraform configuration is missing or unsafe."
        error "Refusing destruction."
        return 1
    fi

    local region

    if ! region="$(python3 - "$generated_config" <<'PYCONFIG'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as f:
        config = json.load(f)

    region = config.get("aws_region")

    if not isinstance(region, str) or not region.strip():
        raise ValueError("aws_region is missing or invalid")

    print(region.strip())

except (OSError, json.JSONDecodeError, ValueError) as exc:
    print(f"Invalid generated Terraform configuration: {exc}", file=sys.stderr)
    sys.exit(1)
PYCONFIG
    )"; then
        error "Cannot determine the original deployment region."
        return 1
    fi

    terraform -chdir="$TERRAFORM_DIR" init
    check_workspace || return 1

    local account_id
    account_id="$(verify_aws_identity "$region")" || return 1

    local state_count
    state_count="$(
        terraform -chdir="$TERRAFORM_DIR" state list 2>/dev/null |
        wc -l
    )"

    if (( state_count == 0 )); then
        warning "No managed Terraform resources were found."
        return 0
    fi

    warning "This operation will destroy resources managed by this Terraform state."

    local plan_dir plan_file
    plan_dir="$(mktemp -d "${TMPDIR:-/tmp}/cloudvpn-destroy.XXXXXX")"
    register_temp_dir "$plan_dir"
    chmod 700 "$plan_dir"
    plan_file="$plan_dir/destroy.tfplan"

    if ! terraform -chdir="$TERRAFORM_DIR" plan \
        -destroy \
        -out="$plan_file"; then
        rm -rf -- "$plan_dir"
        return 1
    fi

    if ! confirm_operation "DESTROY" "$account_id"; then
        rm -rf -- "$plan_dir"
        return 1
    fi

    if ! terraform -chdir="$TERRAFORM_DIR" apply "$plan_file"; then
        rm -rf -- "$plan_dir"
        error "Terraform destruction failed. Review the remaining infrastructure."
        return 1
    fi

    rm -rf -- "$plan_dir"

    success "Terraform-managed infrastructure destruction completed"
    warning "The externally managed S3 transfer bucket is not deleted."
    warning "Local client keys, profiles and Terraform backup files are preserved."
}

main() {
    if [[ $# -ne 1 ]]; then
        usage
        exit 1
    fi

    case "$1" in
        check)
            check_command
            ;;
        configure)
            configure_command
            ;;
        status)
            status_command
            ;;
        deploy)
            deploy_command
            ;;
        destroy)
            destroy_command
            ;;
        help|-h|--help)
            usage
            ;;
        *)
            error "Unknown command: $1"
            usage
            exit 1
            ;;
    esac
}

main "$@"
